---
// FAQPage schema, generated from the same FAQ array that renders the
// visible accordion (FAQ.astro) — text always matches exactly. Answers may
// carry `[label](href)` inline-link syntax (see lib/inline-links); schema
// gets the plain rendered text, same as what FAQ.astro shows on screen.
import { toPlainText } from '../../lib/inline-links';

interface Props {
  items: { question: string; answer: string }[];
}
const { items } = Astro.props;

const data = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: toPlainText(f.answer) },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
