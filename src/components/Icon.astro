---
// Flat two-tone icons (matches the logo's flat flame/brick mark).
// tone: main = currentColor fill, accent = brand red fill, white = white fill,
//       line = currentColor stroke, whiteline = white stroke.
type Tone = 'main' | 'accent' | 'white' | 'line' | 'whiteline';
type Part = { d: string; tone: Tone };

const icons: Record<string, Part[]> = {
  phone: [
    {
      d: 'M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z',
      tone: 'main',
    },
  ],
  flame: [
    { d: 'M12 2c1 4 6 6 6 12a6 6 0 0 1-12 0c0-2.5 1.2-4 2.5-5.3.2 1.6 1 2.6 2 3C10.3 8.2 10.6 5 12 2z', tone: 'main' },
    { d: 'M12 22a3.2 3.2 0 0 1-3.2-3.2c0-1.6 1.4-2.6 3.2-4.8 1.8 2.2 3.2 3.2 3.2 4.8A3.2 3.2 0 0 1 12 22z', tone: 'accent' },
  ],
  shield: [
    { d: 'M12 2l8 3v6c0 5-3.4 9.4-8 11-4.6-1.6-8-6-8-11V5z', tone: 'main' },
    { d: 'M8.5 12l2.5 2.5 4.5-5', tone: 'whiteline' },
  ],
  clock: [
    { d: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z', tone: 'main' },
    { d: 'M12 6.5V12l3.5 2', tone: 'whiteline' },
  ],
  dollar: [
    { d: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z', tone: 'main' },
    { d: 'M12 6v12M15 9.2c-.5-1-1.6-1.5-3-1.5-1.7 0-3 .8-3 2.1 0 3 6 1.4 6 4.2 0 1.3-1.3 2.1-3 2.1-1.4 0-2.6-.6-3.1-1.6', tone: 'whiteline' },
  ],
  clipboard: [
    { d: 'M6 4h12a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z', tone: 'main' },
    { d: 'M9 2h6v4H9z', tone: 'accent' },
    { d: 'M8.5 11h7M8.5 15h7', tone: 'whiteline' },
  ],
  chimney: [
    { d: 'M7 8h10v14H7z', tone: 'main' },
    { d: 'M5 5h14v3H5z', tone: 'accent' },
    { d: 'M7 13h10M7 18h10M12 8v5M9.5 13v5M14.5 13v5', tone: 'whiteline' },
  ],
  check: [
    { d: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z', tone: 'accent' },
    { d: 'M7.5 12.5l3 3 6-6.5', tone: 'whiteline' },
  ],
  star: [{ d: 'M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 21l1.6-7L2 9.2l7.1-.6z', tone: 'accent' }],
  pin: [
    { d: 'M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7z', tone: 'main' },
    { d: 'M12 6.8a2.2 2.2 0 1 0 0 4.4 2.2 2.2 0 0 0 0-4.4z', tone: 'white' },
  ],
  plus: [{ d: 'M12 5v14M5 12h14', tone: 'line' }],
  arrow: [{ d: 'M5 12h14M13 6l6 6-6 6', tone: 'line' }],
  chevron: [{ d: 'M6 9l6 6 6-6', tone: 'line' }],
  menu: [{ d: 'M4 6h16M4 12h16M4 18h16', tone: 'line' }],
  close: [{ d: 'M6 6l12 12M18 6L6 18', tone: 'line' }],
  droplet: [
    { d: 'M12 3c3 4 6.5 8 6.5 12a6.5 6.5 0 0 1-13 0C5.5 11 9 7 12 3z', tone: 'main' },
    { d: 'M9.5 15.5a2.7 2.7 0 0 0 2.7 2.7', tone: 'whiteline' },
  ],
  thermometer: [
    { d: 'M10.5 4a1.5 1.5 0 0 1 3 0v9.6a4 4 0 1 1-3 0z', tone: 'main' },
    { d: 'M12 8v6.8', tone: 'whiteline' },
    { d: 'M12 18a2 2 0 1 0 0-4 2 2 0 0 0 0 4z', tone: 'accent' },
  ],
  wind: [
    { d: 'M3 8h11a2.5 2.5 0 1 0-2.3-3.4', tone: 'line' },
    { d: 'M3 12h15a2.5 2.5 0 1 1-2.3 3.4', tone: 'line' },
    { d: 'M3 16h9a2 2 0 1 1-1.8 2.8', tone: 'line' },
  ],
  vent: [
    { d: 'M4 5h16v3H4z', tone: 'main' },
    { d: 'M4 10h16v9H4z', tone: 'accent' },
    { d: 'M8 13.5a4 4 0 0 1 8 0', tone: 'whiteline' },
  ],
  // Bare checkmark, no circle — for contexts where "check" (red circle) would
  // clash with a different semantic color, e.g. a green "all clear" card.
  checkline: [{ d: 'M5 13l4 4L19 7', tone: 'line' }],
  lint: [
    { d: 'M12 3a9 9 0 1 0 9 9', tone: 'line' },
    { d: 'M12 7a5 5 0 1 0 5 5', tone: 'line' },
    { d: 'M12 11a1 1 0 1 0 1 1', tone: 'line' },
  ],
  gauge: [
    { d: 'M4 18a8 8 0 1 1 16 0', tone: 'line' },
    { d: 'M12 18l4-6', tone: 'line' },
    { d: 'M12 18a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8z', tone: 'accent' },
  ],
  brush: [
    { d: 'M4 20l6-6', tone: 'line' },
    { d: 'M9 15l6-6a2.5 2.5 0 0 1 3.5 3.5l-6 6z', tone: 'main' },
    { d: 'M11 6l2 2M14 4l2 2M17 6l1.5 1.5', tone: 'whiteline' },
  ],
  search: [
    { d: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14z', tone: 'line' },
    { d: 'M16.2 16.2L21 21', tone: 'line' },
  ],
  camera: [
    {
      d: 'M4 8h3l1.5-2h7L17 8h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z',
      tone: 'main',
    },
    { d: 'M12 18a4 4 0 1 0 0-8 4 4 0 0 0 0 8z', tone: 'accent' },
    { d: 'M12 12.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z', tone: 'white' },
  ],
};

interface Props {
  name: keyof typeof icons | (string & {});
  class?: string;
  label?: string;
}
const { name, class: className, label } = Astro.props;
const parts = icons[name] ?? [];
---

<svg
  viewBox="0 0 24 24"
  class={className ?? 'size-6'}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    parts.map((p) => {
      const line = p.tone === 'line' || p.tone === 'whiteline';
      const fill = line
        ? 'none'
        : p.tone === 'accent'
          ? 'var(--color-brand)'
          : p.tone === 'white'
            ? '#fff'
            : 'currentColor';
      const stroke = p.tone === 'line' ? 'currentColor' : p.tone === 'whiteline' ? '#fff' : undefined;
      return <path d={p.d} fill={fill} stroke={stroke} stroke-width={line ? 2 : undefined} />;
    })
  }
</svg>
