---
// BreadcrumbList schema (SEO checklist Section 9). The site's URLs are flat
// (no /blog/ or /services/ folder), so this doesn't parse Astro.url segments —
// each page's layout supplies its own crumb trail, which is "automatic" in the
// sense that the layout builds it the same way for every page of that type,
// not something each individual page hand-writes.
import { site } from '../../data/site';

interface Props {
  items: { name: string; url?: string }[];
}

const { items } = Astro.props;

const data = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    ...(item.url ? { item: new URL(item.url, site.url).href } : {}),
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
