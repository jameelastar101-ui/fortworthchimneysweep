---
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
import Icon from './Icon.astro';
import { site, serviceLinks } from '../data/site';

interface Props {
  hours?: string[];
}
const { hours = site.hours } = Astro.props;
const { address } = site;
---

<footer class="bg-charcoal text-white">
  <div class="container-page grid gap-10 py-14 md:grid-cols-4">
    <div>
      <a href="/" class="inline-block rounded-btn bg-white p-2" aria-label={`${site.name} — home`}>
        <Image src={logo} alt={`${site.name} logo`} class="h-12 w-auto" />
      </a>
      <address class="mt-5 not-italic leading-relaxed text-white/80">
        {address.street}<br />
        {address.city}, {address.region} {address.postalCode}
      </address>
      <a href={site.phoneHref} class="mt-3 inline-flex items-center gap-2 text-xl font-extrabold hover:text-brand">
        <Icon name="phone" class="size-5" />
        {site.phone}
      </a>
    </div>

    {
      hours.length > 0 && (
        <div>
          <h2 class="text-xl">Hours</h2>
          <span class="rule"></span>
          <ul class="space-y-1 text-white/80">
            {hours.map((h) => <li>{h}</li>)}
          </ul>
        </div>
      )
    }

    <div>
      <h2 class="text-xl">Services</h2>
      <span class="rule"></span>
      <ul class="space-y-2 text-white/80">
        {serviceLinks.map((s) => <li><a href={s.href} class="hover:text-brand">{s.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="text-xl">Site</h2>
      <span class="rule"></span>
      <ul class="space-y-2 text-white/80">
        <li><a href="/" class="hover:text-brand">Home</a></li>
        <li><a href="/chimney-sweep-services/" class="hover:text-brand">Chimney Sweep Services</a></li>
        <li><a href="/category/blogs/" class="hover:text-brand">Blog</a></li>
        <li><a href="/contact-us/" class="hover:text-brand">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 py-5 text-center text-sm text-white/60">
    © {new Date().getFullYear()} {site.name}. All rights reserved.
  </div>
</footer>
