---
// Chimney Repair service page — built from the dryer-vent-cleaning
// template, reusing the chimney-inspection page's 6-card 3x2 grid
// (columns={3}) for both Problems and Solutions, and the dryer-vent/
// leak-repair/animal-removal pages' 3-card Now/Soon/Can-Wait urgency
// pattern. A standalone route (not the shared [slug].astro) so this build
// touches no other page or slug. Content collection entry is the single
// source of truth: every visible string is read from its frontmatter, not
// typed here.
//
// Deviations from the existing templates, all scoped to this page/its
// shared components (no component redesigned, per the brief):
//
// 1. Solutions: two plain-text paragraphs after the cards, same
//    `solutions.closingParagraphs` mechanism the animal-removal page added.
//    The second paragraph carries three inline links, so it renders through
//    <Inline> (animal-removal's closingParagraphs are plain strings, since
//    neither of its paragraphs has a link).
//
// 2. Pricing: four tiers in one row. PricingCards only had layouts for
//    1/2/3 equal columns; added a 4-tier case (`sm:grid-cols-2
//    lg:grid-cols-4`, so it's 2x2 before there's room for a full row of 4,
//    then a single row at lg+) — see PricingCards.astro. No included/
//    not-included panels: this page's content gives no copy for them, same
//    as the inspection page.
//    Also added a short plain-text note directly under the cards (the
//    damper line), which didn't fit any existing pricing field — added
//    `pricing.note` to content.config.ts, positioned exactly like
//    `decision.tableNote` is to its table.
//
// 3. Decision framework: table, three prose sub-topics (`decision.
//    proseBlocks`), the waiting-costs line, three urgency cards, then a
//    single DIY paragraph (`decision.diyNote`, no diyVsPro pair), the
//    insurance paragraph, and the cross-link line last — this is the same
//    field set and render order already used by the inspection/relining
//    pages (tableNote is simply omitted here, since this page's copy has
//    none between the table and the prose blocks).
//    No image in this section: the content lists three candidate photos
//    (spalling brick, cracked crown, damaged firebox) for the Decision
//    table, but the shared decision layout only has one image slot (beside
//    the table, same as inspection/relining). Three photos don't fit that
//    slot without a new gallery layout, which the brief says not to invent,
//    so none are placed here — see build report. The three files remain in
//    public/images/chimney-repair/ if a gallery slot is added later.
//
// 4. Local: two blocks, image beside the second (imageBlockIndex: 1), same
//    pattern as the inspection/relining pages. No local.crossLinkLine: the
//    brief explicitly says this page's copy has none.
//
// 5. Schema: one Offer per pricing tier (not an aggregate priceLow/
//    priceHigh), same `ServiceSchema` `offers` prop the animal-removal page
//    already uses, resolved from `pricing.tiers[].priceId` via
//    src/lib/prices' `tierOffers` — the same ids PricingCards renders.
//
// 6. Images: the brief specifies WebP filenames; the files actually present
//    in public/images/chimney-repair/ are .jpg at the same basenames (one,
//    the process-section photo, had a stray double-dot in its filename on
//    disk — renamed to the correct single-dot .jpg before this page was
//    built, since nothing could have intentionally depended on the typo).
//    This page's frontmatter points at the real .jpg files so the images
//    actually render; see build report.
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustBadges from '../components/TrustBadges.astro';
import CardGrid from '../components/CardGrid.astro';
import FramedImage from '../components/FramedImage.astro';
import PricingCards from '../components/PricingCards.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import Stepper from '../components/Stepper.astro';
import CTABand from '../components/CTABand.astro';
import FAQ from '../components/FAQ.astro';
import Inline from '../components/Inline.astro';
import ServiceSchema from '../components/schema/ServiceSchema.astro';
import FAQSchema from '../components/schema/FAQSchema.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { resolveTiers, tierOffers as resolveTierOffers, interpolatePrices } from '../lib/prices';

const entry = await getEntry('services', 'chimney-repair-fort-worth-tx');
if (!entry) throw new Error('Missing services entry: chimney-repair-fort-worth-tx');
const d = entry.data;
if (entry.id !== d.slug) {
  throw new Error(`Service entry "${entry.id}" has frontmatter slug "${d.slug}" — they must match.`);
}

const canonicalHref = new URL(Astro.url.pathname, Astro.site).href;

const imgProblems = d.images?.problems;
const imgSolutions = d.images?.solutions;
const imgProcess = d.images?.process;
const imgLocal = d.images?.local;

const localBlock0 = d.local?.blocks?.[0];
const localBlock1 = d.local?.blocks?.[1];
const localImageBlockIndex = d.local?.imageBlockIndex;

const pricingTiers = d.pricing?.tiers && resolveTiers(d.pricing.tiers);
const tierOffers = d.pricing?.tiers && resolveTierOffers(d.pricing.tiers);
---

<BaseLayout title={d.titleTag ?? d.title} description={d.metaDescription} ogImage={d.ogImage} ogType="website">
  <Fragment slot="head">
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </Fragment>

  {d.serviceType && tierOffers && tierOffers.length > 0 && (
    <ServiceSchema
      name={d.title}
      description={d.metaDescription}
      serviceType={d.serviceType}
      areaServed={d.areaServed ?? []}
      offers={tierOffers}
      url={canonicalHref}
    />
  )}
  {d.faqs && d.faqs.length > 0 && <FAQSchema items={d.faqs} />}
  <BreadcrumbSchema items={[{ name: 'Home', url: '/' }, { name: d.title }]} />

  <!-- 2. Hero -->
  <Hero
    headline={d.title}
    subhead={d.subheading ?? ''}
    ctaLabel="Call"
    ctaId="hero"
    showSecondaryCta={false}
    normalCaseH1
    ctaLine="to book an assessment and get a written diagnosis of your chimney."
    imageSrc={d.heroImage?.src}
    imageAlt={d.heroImage?.alt ?? ''}
  />
  <TrustBadges />

  <!-- 3. Problems -->
  {d.problems && (
    <section class="section bg-white">
      <div class="container-page">
        <h2 class="section-title">{d.problems.heading}</h2>
        <span class="rule"></span>
        <p class="reveal max-w-[65ch] text-lg leading-relaxed">{d.problems.opening}</p>
        <div class="mt-8 grid gap-10 md:grid-cols-[3fr_2fr] md:items-start">
          <CardGrid items={d.problems.items} columns={3} />
          {imgProblems && <FramedImage src={imgProblems.src} alt={imgProblems.alt} caption={imgProblems.caption} ratio="4:3" />}
        </div>
      </div>
    </section>
  )}

  <!-- 4. Solutions -->
  {d.solutions && (
    <section class="section bg-cream">
      <div class="container-page">
        <h2 class="section-title">{d.solutions.heading}</h2>
        <span class="rule"></span>
        <p class="reveal max-w-[65ch] text-lg leading-relaxed">{d.solutions.opening}</p>
        {d.solutions.imageSide !== 'none' && imgSolutions ? (
          <div class="mt-8 grid gap-10 md:grid-cols-[2fr_3fr] md:items-start">
            {d.solutions.imageSide === 'left' && (
              <FramedImage src={imgSolutions.src} alt={imgSolutions.alt} caption={imgSolutions.caption} ratio="4:3" />
            )}
            <div>
              <CardGrid items={d.solutions.items} columns={3} />
            </div>
            {d.solutions.imageSide === 'right' && (
              <FramedImage src={imgSolutions.src} alt={imgSolutions.alt} caption={imgSolutions.caption} ratio="4:3" />
            )}
          </div>
        ) : (
          <div class="mt-8">
            <CardGrid items={d.solutions.items} columns={3} />
          </div>
        )}
        {d.solutions.closingParagraphs && d.solutions.closingParagraphs.length > 0 && (
          <div class="mt-8 max-w-[65ch] space-y-4">
            {d.solutions.closingParagraphs.map((p) => (
              <p class="reveal text-muted">
                <Inline text={p} />
              </p>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- 5. Pricing -->
  {d.pricing && (
    <section class="section bg-white">
      <div class="container-page">
        <h2 class="section-title">{d.pricing.heading}</h2>
        <span class="rule"></span>
        <p class="reveal max-w-[65ch] text-lg leading-relaxed">{interpolatePrices(d.pricing.opening)}</p>
        <div class="mt-8">
          <PricingCards tiers={pricingTiers!} />
        </div>
        {d.pricing.note && <p class="reveal mt-6 max-w-[65ch] text-muted">{d.pricing.note}</p>}
        {d.pricing.costFactors && d.pricing.costFactors.length > 0 && (
          <ul class="reveal mt-8 max-w-[65ch] list-disc space-y-2 pl-5 text-muted">
            {d.pricing.costFactors.map((f) => <li>{f}</li>)}
          </ul>
        )}
        <p class="reveal mt-8 max-w-[65ch] font-semibold">{d.pricing.closingLine}</p>
      </div>
    </section>
  )}

  <!-- 6. Decision framework -->
  {d.decision && (
    <section class="section border-t border-line bg-white">
      <div class="container-page">
        <h2 class="section-title">{d.decision.heading}</h2>
        <span class="rule"></span>
        <p class="reveal max-w-[65ch] text-lg leading-relaxed">{d.decision.opening}</p>

        <div class="mt-8">
          <ComparisonTable head={d.decision.tableHead} rows={d.decision.tableRows} />
        </div>
        {d.decision.tableNote && <p class="reveal mt-6 max-w-[65ch] text-muted">{d.decision.tableNote}</p>}

        {d.decision.proseBlocks && d.decision.proseBlocks.length > 0 && (
          <div class="mt-8 grid gap-8 md:grid-cols-2">
            {d.decision.proseBlocks.map((block) => (
              <div class="reveal">
                <h3 class="text-xl">{block.heading}</h3>
                <p class="mt-2 text-muted">
                  <Inline text={block.body} />
                </p>
              </div>
            ))}
          </div>
        )}

        {d.decision.waitingCostsNote && <p class="reveal mt-8 max-w-[65ch] text-muted">{d.decision.waitingCostsNote}</p>}

        <div class="mt-10 max-w-3xl">
          <CardGrid items={d.decision.urgency} columns={d.decision.urgency.length === 3 ? 3 : 2} />
        </div>

        {d.decision.diyVsPro ? (
          <div class="mt-10 max-w-3xl">
            <CardGrid items={d.decision.diyVsPro} columns={2} />
          </div>
        ) : (
          d.decision.diyNote && <p class="reveal mt-8 max-w-[65ch] text-muted">{d.decision.diyNote}</p>
        )}

        {d.decision.actionNote && <p class="reveal mt-8 max-w-[65ch] text-muted">{d.decision.actionNote}</p>}

        <p class="reveal mt-8 max-w-[65ch] text-muted">{d.decision.insuranceNote}</p>
        {d.decision.crossLinkLine && (
          <p class="reveal mt-4 max-w-[65ch] text-muted">
            <Inline text={d.decision.crossLinkLine} />
          </p>
        )}
      </div>
    </section>
  )}

  <!-- 7. Mid-page CTA -->
  {d.midCta && <CTABand ctaId="mid" heading={d.midCta.headline} text={d.midCta.text} />}

  <!-- 8. Process -->
  {d.process && d.steps && d.steps.length > 0 && (
    <section class="section bg-cream">
      <div class="container-page">
        <h2 class="section-title">{d.process.heading}</h2>
        <span class="rule"></span>
        <div class="mt-8 grid gap-10 md:grid-cols-[1.2fr_1fr] md:items-start">
          {imgProcess && (
            <div class="order-1 md:order-2 md:sticky md:top-24">
              <FramedImage src={imgProcess.src} alt={imgProcess.alt} caption={imgProcess.caption} ratio="4:3" />
            </div>
          )}
          <div class="order-2 md:order-1">
            <Stepper steps={d.steps} tone="light" />
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 9. Local -->
  {d.local && (
    <section class="section bg-white">
      <div class="container-page">
        <h2 class="section-title">{d.local.heading}</h2>
        <span class="rule"></span>
        <p class="reveal max-w-[65ch] text-lg leading-relaxed">{d.local.opening}</p>

        {localBlock0 && (
          <div class="reveal mt-8 max-w-[65ch]">
            <h3 class="text-xl">{localBlock0.heading}</h3>
            <p class="mt-2 text-muted">{localBlock0.body}</p>
          </div>
        )}

        {localBlock1 && (
          <div class="mt-8 grid gap-8 md:grid-cols-[1.3fr_1fr] md:items-start">
            <div class="reveal">
              <h3 class="text-xl">{localBlock1.heading}</h3>
              <p class="mt-2 text-muted">{localBlock1.body}</p>
            </div>
            {localImageBlockIndex === 1 && imgLocal && (
              <FramedImage src={imgLocal.src} alt={imgLocal.alt} caption={imgLocal.caption} ratio="4:3" class="md:justify-self-end" />
            )}
          </div>
        )}

        <div class="reveal mt-10 max-w-[65ch] space-y-2 border-t border-line pt-6">
          <p>{d.local.serviceAreaLine}</p>
          <p>{d.local.nap}</p>
          {d.local.crossLinkLine && (
            <p>
              <Inline text={d.local.crossLinkLine} />
            </p>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- 10. FAQ -->
  {d.faqs && d.faqs.length > 0 && <FAQ heading={d.faqHeading} items={d.faqs} bg="cream" />}

  <!-- 11. Closing CTA -->
  {d.closingCta && (
    <CTABand ctaId="closing" heading={d.closingCta.headline} text={d.closingCta.text} brickPattern />
  )}
</BaseLayout>

<script>
  const reveals = document.querySelectorAll('.reveal');
  if (reveals.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
    );
    reveals.forEach((el) => io.observe(el));
  }
</script>
