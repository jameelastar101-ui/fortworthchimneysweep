---
import Icon from './Icon.astro';
import Inline from './Inline.astro';

export interface FaqItem {
  question: string;
  answer: string;
}
interface Props {
  heading?: string;
  // Same array should feed FAQSchema.astro so schema always matches the visible copy.
  items: FaqItem[];
  bg?: 'white' | 'cream';
}
const { heading = 'Frequently Asked Questions', items, bg = 'white' } = Astro.props;
---

{
  items.length > 0 && (
    <section class:list={['section', bg === 'cream' ? 'bg-cream' : 'bg-white']}>
      <div class="container-page max-w-[820px]">
        <h2 class="section-title">{heading}</h2>
        <span class="rule" />
        <div class="grid gap-3">
          {items.map((f, i) => (
            <details
              name="faq-accordion"
              class="reveal group rounded-card border-2 border-line bg-white open:border-brand"
              style={`transition-delay:${i * 60}ms`}
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 text-lg font-extrabold [&::-webkit-details-marker]:hidden">
                {f.question}
                <Icon name="plus" class="size-6 shrink-0 text-brand transition group-open:rotate-45" />
              </summary>
              <div class="answer-wrap px-4 text-muted">
                <p class="pb-4">
                  <Inline text={f.answer} />
                </p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  /* Height/opacity open transition, CSS-only (native <details>, no JS). */
  .answer-wrap {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 300ms ease-out,
      opacity 200ms ease-out;
  }
  details[open] .answer-wrap {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .answer-wrap > p {
    min-height: 0;
    overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .answer-wrap {
      transition: none;
    }
  }
</style>
