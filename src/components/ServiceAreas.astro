---
import Icon from './Icon.astro';

interface Props {
  heading: string;
  intro?: string;
  neighborhoods: string[];
  zips: string[];
}
const { heading, intro, neighborhoods, zips } = Astro.props;
---

<section class="section bg-cream">
  <div class="container-page">
    <h2 class="section-title">{heading}</h2>
    <span class="rule"></span>
    {intro && <p class="max-w-2xl text-lg text-muted">{intro}</p>}
    <div class:list={['mt-8 grid gap-10', zips.length > 0 && 'md:grid-cols-[1.4fr_1fr]']}>
      <div>
        <h3 class="text-xl">Neighborhoods</h3>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-3">
          {
            neighborhoods.map((n) => (
              <li class="flex items-center gap-2 font-semibold">
                <Icon name="pin" class="size-4 shrink-0 text-brand" />
                {n}
              </li>
            ))
          }
        </ul>
      </div>
      {
        zips.length > 0 && (
          <div>
            <h3 class="text-xl">ZIP Codes</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {zips.map((z) => <li class="rounded-btn bg-ink px-3 py-1 text-sm font-bold text-white">{z}</li>)}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</section>
