---
// Raccoon in Chimney Removal service page — a spoke of
// chimney-animal-removal-fort-worth-tx, built from that hub page's template
// as-is (same as the squirrel and bird builds). No component was redesigned,
// re-styled, or rebuilt; every section reuses the same component +
// content.config.ts fields those pages already use. A standalone route (not
// the shared [slug].astro) so this build touches no other page or slug.
// Content collection entry is the single source of truth: every visible
// string is read from its frontmatter, not typed here.
//
// Same handling as chimney-animal-removal-fort-worth-tx and the squirrel
// page, reused as-is:
// - Pricing: the second tier (Flue Cleaning and Sanitizing) is flagged
//   `addOn: true` and rendered by PricingCards as the smaller dashed-border
//   card below the main one, joined by a decorative "+". No label added.
//   This page has only one main tier (Raccoon Removal, open-ended
//   "$500-$600+"), so PricingCards centers it as a single wide card
//   (mainTiers.length === 1) with the add-on centered below it — the same
//   component logic as squirrel/hub, just with one fewer main tier. Neither
//   card leaves an empty grid slot, which is the "fills the row" requirement
//   from the brief; it does not mean styling the add-on card as an equal
//   grid sibling (that would mean dropping the add-on treatment the brief
//   also asks to reuse). No image in this section (template has no image
//   slot there regardless).
// - Decision framework: `tableNote` carries inline links, so it renders
//   through <Inline>. actionNote/diyNote/healthNote/insuranceNote are
//   grouped into one compact block via the Callout component, in that
//   order, matching the brief's required paragraph order.
// - Decision framework images: two more real photos exist
//   (closed-fireplace-doors-damper-lever-shut, raccoon-on-chimney-top), but
//   this section has no image slot in the shared template, and two photos
//   don't fit beside the table/prose blocks without inventing a new gallery
//   layout. Omitted, same precedent as the squirrel and hub pages. Files
//   stay in public/images/raccoon-removal/ if a gallery slot gets added
//   later.
// - Problems section: the brief's optional second image
//   (droppings-and-nest-debris-fireplace-hearth) has no second image slot
//   in the Problems section template (one FramedImage beside a 3-column
//   CardGrid) without crowding the 3fr/2fr layout, so only the primary
//   image (bent-fireplace-damper-animal-damage) is used. Not placed
//   anywhere else either, since the brief names no other slot for it.
// - Local: thin by design — only heading, the service-area paragraph, NAP,
//   and the image render (no opening line separate from the service-area
//   text, no blocks, no extra cross-link line). This page's service-area
//   line carries its own inline link ("See our chimney sweep services"),
//   so — like chimney-sweep-fort-worth-tx, chimney-sweep-keller-tx, and
//   chimney-sweep-services — `local.serviceAreaLine` renders through
//   <Inline> rather than as a plain string. That's an existing rendering
//   pattern already used on three other pages, not a new one.
// - Schema: `ServiceSchema` gets one Offer per pricing tier via `offers`,
//   including the open-ended Raccoon Removal tier ($500-$600+, no
//   maxPrice) — same pattern as the hub and squirrel pages.
//
// Flagged per Hard Rule 8 (content that doesn't fit an existing component
// shape, smallest extension used instead of a new layout):
// - The Decision Framework section needs four distinct plain-text
//   paragraphs in order (what-to-do-right-now, DIY caution, health,
//   insurance), but the `decision` schema only had three Callout-shaped
//   slots (actionNote, diyNote, insuranceNote). Added one optional
//   `healthNote: z.string().optional()` field to content.config.ts,
//   rendered with the exact same Callout component already used for the
//   other three, in between diyNote and insuranceNote. No new component,
//   no new layout — just one more slot of a shape that already existed,
//   and it's optional so every other page's `decision` block is unaffected.
//
// Internal links to squirrel-in-chimney-removal-fort-worth-tx and
// bird-in-chimney-removal point to existing entries; chimney-animal-removal,
// chimney-cap-installation, chimney-relining, and chimney-sweep-services
// also resolve. Rendered as given, word for word, per Hard Rule 1.
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustBadges from '../components/TrustBadges.astro';
import CardGrid from '../components/CardGrid.astro';
import Callout from '../components/Callout.astro';
import FramedImage from '../components/FramedImage.astro';
import PricingCards from '../components/PricingCards.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import Stepper from '../components/Stepper.astro';
import CTABand from '../components/CTABand.astro';
import FAQ from '../components/FAQ.astro';
import Inline from '../components/Inline.astro';
import ServiceSchema from '../components/schema/ServiceSchema.astro';
import FAQSchema from '../components/schema/FAQSchema.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { resolveTiers, tierOffers as resolveTierOffers, interpolatePrices } from '../lib/prices';

const entry = await getEntry('services', 'raccoon-in-chimney-fort-worth-tx');
if (!entry) throw new Error('Missing services entry: raccoon-in-chimney-fort-worth-tx');
const d = entry.data;
if (entry.id !== d.slug) {
  throw new Error(`Service entry "${entry.id}" has frontmatter slug "${d.slug}" — they must match.`);
}

const canonicalHref = new URL(Astro.url.pathname, Astro.site).href;

const imgProblems = d.images?.problems;
const imgSolutions = d.images?.solutions;
const imgProcess = d.images?.process;
const imgLocal = d.images?.local;

const pricingTiers = d.pricing?.tiers && resolveTiers(d.pricing.tiers);
const tierOffers = d.pricing?.tiers && resolveTierOffers(d.pricing.tiers);
---

<BaseLayout title={d.titleTag ?? d.title} description={d.metaDescription} ogImage={d.ogImage} ogType="website">
  <Fragment slot="head">
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </Fragment>

  {d.serviceType && tierOffers && tierOffers.length > 0 && (
    <ServiceSchema
      name={d.title}
      description={d.metaDescription}
      serviceType={d.serviceType}
      areaServed={d.areaServed ?? []}
      offers={tierOffers}
      url={canonicalHref}
    />
  )}
  {d.faqs && d.faqs.length > 0 && <FAQSchema items={d.faqs} />}
  <BreadcrumbSchema items={[{ name: 'Home', url: '/' }, { name: d.title }]} />

  <!-- 2. Hero -->
  <Hero
    headline={d.title}
    subhead={d.subheading ?? ''}
    ctaLabel="Call"
    ctaId="hero"
    showSecondaryCta={false}
    normalCaseH1
    ctaLine="to book a removal or to describe what you are hearing."
    imageSrc={d.heroImage?.src}
    imageAlt={d.heroImage?.alt ?? ''}
  />
  <TrustBadges />

  <!-- 3. Problems -->
  {d.problems && (
    <section class="section bg-white">
      <div class="container-page">
        <h2 class="section-title">{d.problems.heading}</h2>
        <span class="rule"></span>
        <p class="reveal max-w-[65ch] text-lg leading-relaxed">{d.problems.opening}</p>
        <div class="mt-8 grid gap-10 md:grid-cols-[3fr_2fr] md:items-start">
          <CardGrid items={d.problems.items} columns={3} />
          {imgProblems && <FramedImage src={imgProblems.src} alt={imgProblems.alt} caption={imgProblems.caption} ratio="4:3" />}
        </div>
      </div>
    </section>
  )}

  <!-- 4. Solutions -->
  {d.solutions && (
    <section class="section bg-cream">
      <div class="container-page">
        <h2 class="section-title">{d.solutions.heading}</h2>
        <span class="rule"></span>
        <p class="reveal max-w-[65ch] text-lg leading-relaxed">{d.solutions.opening}</p>
        {d.solutions.imageSide !== 'none' && imgSolutions ? (
          <div class="mt-8 grid gap-10 md:grid-cols-[2fr_3fr] md:items-start">
            {d.solutions.imageSide === 'left' && (
              <FramedImage src={imgSolutions.src} alt={imgSolutions.alt} caption={imgSolutions.caption} ratio="4:3" />
            )}
            <div>
              <CardGrid items={d.solutions.items} columns={3} />
            </div>
            {d.solutions.imageSide === 'right' && (
              <FramedImage src={imgSolutions.src} alt={imgSolutions.alt} caption={imgSolutions.caption} ratio="4:3" />
            )}
          </div>
        ) : (
          <div class="mt-8">
            <CardGrid items={d.solutions.items} columns={3} />
          </div>
        )}
        {d.solutions.closingParagraphs && d.solutions.closingParagraphs.length > 0 && (
          <div class="mt-8 max-w-[65ch] space-y-4">
            {d.solutions.closingParagraphs.map((p) => (
              <p class="reveal text-muted">{p}</p>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- 5. Pricing -->
  {d.pricing && (
    <section class="section bg-white">
      <div class="container-page">
        <h2 class="section-title">{d.pricing.heading}</h2>
        <span class="rule"></span>
        <p class="reveal max-w-[65ch] text-lg leading-relaxed">{interpolatePrices(d.pricing.opening)}</p>
        <div class="mt-8">
          <PricingCards tiers={pricingTiers!} />
        </div>
        {d.pricing.costFactors && d.pricing.costFactors.length > 0 && (
          <ul class="reveal mt-8 max-w-[65ch] list-disc space-y-2 pl-5 text-muted">
            {d.pricing.costFactors.map((f) => (
              <li>
                <Inline text={f} />
              </li>
            ))}
          </ul>
        )}
        <p class="reveal mt-8 max-w-[65ch] font-semibold">{d.pricing.closingLine}</p>
      </div>
    </section>
  )}

  <!-- 6. Decision framework -->
  {d.decision && (
    <section class="section border-t border-line bg-white">
      <div class="container-page">
        <h2 class="section-title">{d.decision.heading}</h2>
        <span class="rule"></span>
        <p class="reveal max-w-[65ch] text-lg leading-relaxed">{d.decision.opening}</p>

        <div class="mt-8">
          <ComparisonTable head={d.decision.tableHead} rows={d.decision.tableRows} />
        </div>
        {d.decision.tableNote && (
          <p class="reveal mt-6 max-w-[65ch] text-muted">
            <Inline text={d.decision.tableNote} />
          </p>
        )}

        {d.decision.proseBlocks && d.decision.proseBlocks.length > 0 && (
          <div class="mt-8 grid gap-8 md:grid-cols-2">
            {d.decision.proseBlocks.map((block) => (
              <div class="reveal">
                <h3 class="text-xl">{block.heading}</h3>
                <p class="mt-2 text-muted">
                  <Inline text={block.body} />
                </p>
              </div>
            ))}
          </div>
        )}

        {d.decision.waitingCostsNote && <p class="reveal mt-8 max-w-[65ch] text-muted">{d.decision.waitingCostsNote}</p>}

        <div class="mt-10 max-w-3xl">
          <CardGrid items={d.decision.urgency} columns={d.decision.urgency.length === 3 ? 3 : 2} />
        </div>

        <div class="mt-8 max-w-[65ch] space-y-3">
          {d.decision.actionNote && <Callout text={d.decision.actionNote} />}
          {d.decision.diyNote && <Callout text={d.decision.diyNote} />}
          {d.decision.healthNote && <Callout text={d.decision.healthNote} />}
          <Callout text={d.decision.insuranceNote} />
        </div>
        {d.decision.crossLinkLine && (
          <p class="reveal mt-4 max-w-[65ch] text-muted">
            <Inline text={d.decision.crossLinkLine} />
          </p>
        )}
      </div>
    </section>
  )}

  <!-- 7. Mid-page CTA -->
  {d.midCta && <CTABand ctaId="mid" heading={d.midCta.headline} text={d.midCta.text} />}

  <!-- 8. Process -->
  {d.process && d.steps && d.steps.length > 0 && (
    <section class="section bg-cream">
      <div class="container-page">
        <h2 class="section-title">{d.process.heading}</h2>
        <span class="rule"></span>
        <div class="mt-8 grid gap-10 md:grid-cols-[1.2fr_1fr] md:items-start">
          {imgProcess && (
            <div class="order-1 md:order-2 md:sticky md:top-24">
              <FramedImage src={imgProcess.src} alt={imgProcess.alt} caption={imgProcess.caption} ratio="4:3" />
            </div>
          )}
          <div class="order-2 md:order-1">
            <Stepper steps={d.steps} tone="light" />
            {d.process.note && (
              <p class="reveal mt-6 text-muted">
                <Inline text={d.process.note} />
              </p>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 9. Local -->
  {d.local && (
    <section class="section bg-white">
      <div class="container-page">
        <h2 class="section-title">{d.local.heading}</h2>
        <span class="rule"></span>
        <div class="mt-8 grid gap-10 md:grid-cols-[3fr_2fr] md:items-start">
          <div class="reveal">
            <p class="text-lg leading-relaxed">
              <Inline text={d.local.serviceAreaLine} />
            </p>
            <div class="mt-10 max-w-[65ch] space-y-2 border-t border-line pt-6">
              <p>{d.local.nap}</p>
            </div>
          </div>
          {imgLocal && <FramedImage src={imgLocal.src} alt={imgLocal.alt} caption={imgLocal.caption} ratio="4:3" />}
        </div>
      </div>
    </section>
  )}

  <!-- 10. FAQ -->
  {d.faqs && d.faqs.length > 0 && <FAQ heading={d.faqHeading} items={d.faqs} bg="cream" />}

  <!-- 11. Closing CTA -->
  {d.closingCta && (
    <CTABand ctaId="closing" heading={d.closingCta.headline} text={d.closingCta.text} brickPattern />
  )}
</BaseLayout>

<script>
  const reveals = document.querySelectorAll('.reveal');
  if (reveals.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
    );
    reveals.forEach((el) => io.observe(el));
  }
</script>
