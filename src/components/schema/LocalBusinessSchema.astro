---
import { getImage } from 'astro:assets';
import logo from '../../assets/logo.webp';
import { site } from '../../data/site';

// Rendered once, sitewide, from BaseLayout. Only facts we actually have are emitted:
// add `geo` and `openingHours` here once lat/long and hours are confirmed (see site.ts).
const logoUrl = new URL((await getImage({ src: logo })).src, site.url).href;

const data = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  url: `${site.url}/`,
  telephone: '+1-682-354-6644',
  image: logoUrl,
  logo: logoUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: 'US',
  },
  // site.areaServed is the single source of truth, also read by the
  // homepage/contact-us ServiceAreas section — kept in sync, not hand-typed
  // separately (docs/service-page-seo-checklist.md Section 9).
  areaServed: site.areaServed.map((name) => ({
    '@type': 'City',
    name,
    containedInPlace: { '@type': 'State', name: 'Texas' },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
